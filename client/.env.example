# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# API Configuration
REACT_APP_API_URL=http://localhost:5001

# Stripe Configuration
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Price IDs (get these from your Stripe Dashboard)
REACT_APP_STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly
REACT_APP_STRIPE_PRICE_STARTER_ANNUAL=price_starter_annual
REACT_APP_STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
REACT_APP_STRIPE_PRICE_PRO_ANNUAL=price_pro_annual
REACT_APP_STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_monthly
REACT_APP_STRIPE_PRICE_ENTERPRISE_ANNUAL=price_enterprise_annual
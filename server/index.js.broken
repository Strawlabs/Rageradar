// Public preview analysis endpoint (no authentication required)
app.post('/api/preview-analyze', async (req, res) => {
  try {
    const { brandName } = req.body;

    if (!brandName) {
      return res.status(400).json({ error: 'Brand name is required' });
    }

    console.log(`Starting preview analysis for brand: ${brandName}`);

    try {
      // Search for brand mentions (limited to fewer results for preview)
      const searchResults = await searchBrand(brandName);
      console.log(`Found ${searchResults.length} search results for preview`);

      if (searchResults.length === 0) {
        console.log('No search results found, using demo data');
        return res.json(generatePreviewDemoData(brandName));
      }

      // Limit results for preview (first 10 results only)
      const limitedResults = searchResults.slice(0, 10);
      
      // Analyze emotions on limited dataset
      const analysis = await processSearchResults(limitedResults);
      console.log('Preview analysis completed');

      // Return limited preview data
      const previewData = {
        brand: brandName,
        overallSentiment: Math.round(analysis.overallSentimentScore),
        emotions: Object.entries(analysis.emotions)
          .sort(([,a], [,b]) => b - a)
          .slice(0, 3)
          .map(([emotion, count]) => ({
            emotion,
            percentage: Math.round((count / limitedResults.length) * 100)
          })),
        recentComments: limitedResults
          .filter(result => result.snippet && result.snippet.length > 20)
          .slice(0, 3)
          .map(result => ({
            text: result.snippet,
            platform: result.platform,
            date: new Date().toISOString() // Use current date for preview
          })),
        totalMentions: limitedResults.length,
        isPreview: true
      };

      res.json(previewData);

    } catch (searchError) {
      // If search fails (rate limit, API issues, etc.), use demo data
      console.log('Search failed, using demo data:', searchError.message);
      return res.json(generatePreviewDemoData(brandName));
    }

  } catch (error) {
    console.error('Preview analysis error:', error);
    // Even if there's an error, try to return demo data instead of failing
    try {
      return res.json(generatePreviewDemoData(req.body.brandName || 'Unknown Brand'));
    } catch (demoError) {
      res.status(500).json({ error: 'Analysis failed. Please try again.' });
    }
  }
});

